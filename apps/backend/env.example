# Copy this file to `.env` in apps/backend before running the API.
NODE_ENV=development
PORT=8080
LOG_LEVEL=debug
DATABASE_URL=postgres://settle:settle@localhost:5432/settle
# Optional. Unset = inferred from host (localhost -> disable, managed DB -> require).
# disable = no TLS | require = TLS, no CA check | verify = TLS + CA check
# DATABASE_SSL=require
# comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
# where uploaded raw emails / receipt images are stored on disk
STORAGE_DIR=./.storage

# --- auth (required) ---
# Secret for signing session JWTs. Use a long random string in real deployments.
JWT_SECRET=dev-only-change-me-please-32-chars-min
# Session lifetime in seconds (default 7 days) and cookie name.
SESSION_TTL_SECONDS=604800
SESSION_COOKIE=settle_session
# Password seeded for every existing employee so sign-in works immediately.
SEED_DEFAULT_PASSWORD=Nortex@2026
# Set to 'false' to disable the legacy `x-user` header identity (default: on outside prod).
# ALLOW_HEADER_AUTH=true
