{
  "name": "@settle/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./src/index.ts",
  "source": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./http": {
      "import": "./dist/http-status.js",
      "default": "./src/http-status.ts"
    },
    "./errors": {
      "import": "./dist/error-codes.js",
      "default": "./src/error-codes.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"(no linter configured)\" && exit 0",
    "test": "echo \"(no tests)\" && exit 0"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
